[TEMPLATE]
# ---------- Frontend (Vite) ----------
VITE_GITHUB_USERNAME=WARRIORXR
# Origin of the Rust API gateway. Optional: without it (or when the gateway is
# unreachable) the site falls back to fetching GitHub straight from the browser.
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ---------- Rust gateway (backend/rust-api) ----------
# HOST=127.0.0.1
# PORT=8080
# PY_SERVICE_URL=http://127.0.0.1:8000
# GITHUB_USERNAME=WARRIORXR
# GITHUB_TOKEN=            # optional: raises the GitHub limit from 60 to 5000 req/hour
# GITHUB_CACHE_TTL=3600
# GITHUB_TIMEOUT=10
# CONTACT_RATE_LIMIT=5
# STATIC_DIR=dist          # defaults to <repo>/dist
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5199

# ---------- Python service (backend/py-service) ----------
# PROFILE_PATH=shared/profile.json
# CONTACT_STORE=backend/py-service/data/messages.jsonl
# GITHUB_TOKEN=
# Without SMTP_HOST + CONTACT_TO + CONTACT_FROM the service queues messages to
# the JSONL store instead of sending them (dry-run mode).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# CONTACT_TO=tanishjaswal56@gmail.com
# CONTACT_FROM=portfolio@example.com
